# Normalize line endings to LF in the repo; protects gofmt/prettier gates in CI.
* text=auto eol=lf

*.go   text eol=lf
*.mod  text eol=lf
*.sum  text eol=lf
*.sh   text eol=lf
*.ts   text eol=lf
*.tsx  text eol=lf
*.json text eol=lf
*.md   text eol=lf

# Binaries are left untouched.
*.png binary
*.jpg binary
*.ico binary
*.woff2 binary
